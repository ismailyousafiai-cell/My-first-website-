<!DOCTYPE html>
<html>
<head>
<title>UK Countdown - Ismail</title>
<style>
body { font-family: Arial; text-align: center; background: #e8eaf6; padding: 30px; }
.box { background: white; padding: 25px; border-radius: 15px; max-width: 400px; margin: auto; }
h1 { color: #1a237e; }
h2 { color: #d32f2f; font-size: 30px; }
</style>
</head>
<body>
<div class="box">
<h1>UK Jane Mein Kitne Din Baki?</h1>
<p>By Ismail - Project 23</p>
<p>Target: June 2030 - 19 Saal Pe</p>
<h2 id="days"></h2>
<p>Wembley Road - BJSS - £50k</p>
<button onclick="check()" style="padding:12px 25px; background:#1a237e; color:white; border:none; border-radius:8px; font-size:16px;">Check Karo</button>
</div>

<script>
function check(){
let target = new Date("2030-06-01");
let today = new Date();
let diff = target - today;
let days = Math.floor(diff / (1000*60*60*24));
document.getElementById("days").innerHTML = days + " Din Baki Hain!";
}
check();
</script>
</body>
</html>